<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/GameLoading/LoadingScene/LoadingScene.uss?fileID=7433441132597879392&amp;guid=d9c99d217935b8c488d9c4f69243132f&amp;type=3#LoadingScene" />
    <ui:VisualElement style="flex-grow: 1; flex-direction: column-reverse; align-items: center; padding-top: 50px; padding-right: 50px; padding-bottom: 50px; padding-left: 50px; background-color: rgb(51, 51, 51);">
        <ui:VisualElement name="Slider" class="slider-horizontal" style="width: 80%; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; flex-direction: column; height: auto;">
            <ui:Label tabindex="-1" text="加载中。。。" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Title" class="slider-horizontal-title" style="display: flex; -unity-text-align: middle-center; width: 100%; height: 30px;" />
            <ui:VisualElement name="Container" class="slider-horizontal-container" style="height: 30px; flex-shrink: 1; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; width: 100%;">
                <ui:VisualElement name="Tracker" class="slider-horizontal-tracker" style="border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px;">
                    <ui:VisualElement name="Dragger" class="slider-horizontal-dragger" style="display: none;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement style="flex-grow: 1; position: absolute; left: 0; top: 0; right: 0; bottom: 0;" />
</ui:UXML>
