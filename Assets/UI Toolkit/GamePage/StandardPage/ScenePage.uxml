        <ui:VisualElement style="height: 100px; width: 1580px; flex-direction: row; align-items: center;">
            <ui:Button text="返回" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Button1" class="page-button button-01" style="width: 120px; height: 60px; font-size: 24px;" />
            <ui:VisualElement style="flex-grow: 1;" />
