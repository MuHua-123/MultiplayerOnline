    <ui:VisualElement style="flex-grow: 1; align-items: center; padding-top: 50px; padding-right: 50px; padding-bottom: 50px; padding-left: 50px;">
        <ui:VisualElement style="width: auto; height: 100px;">
            <ui:Label tabindex="-1" text="选择场景" parse-escape-sequences="true" display-tooltip-when-elided="true" style="flex-grow: 1; -unity-text-align: middle-center; font-size: 36px; color: rgb(255, 255, 255);" />
        </ui:VisualElement>
        <ui:VisualElement name="ScrollView" class="scrollview" style="flex-grow: 1; width: 1620px;">
            <ui:VisualElement name="Viewport" class="scrollview-viewport" style="margin-right: 0; margin-top: 0; margin-bottom: 0; margin-left: 0; background-color: rgba(255, 255, 255, 0);">
                <ui:VisualElement name="Container" class="scrollview-container" style="width: auto; height: 100%; flex-direction: row; background-color: rgba(0, 0, 0, 0); align-items: center;">
                    <ui:Instance template="SceneCardTemplate" name="SceneCardTemplate" />
                    <ui:Instance template="SceneCardTemplate" name="SceneCardTemplate" />
                    <ui:Instance template="SceneCardTemplate" name="SceneCardTemplate" />
                    <ui:Instance template="SceneCardTemplate" name="SceneCardTemplate" />
