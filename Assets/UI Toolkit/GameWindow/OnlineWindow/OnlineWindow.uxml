    <ui:VisualElement name="Window" class="window" style="width: 400px; height: 400px; left: 760px; top: 340px;">
        <ui:VisualElement name="Top" class="window-top">
            <ui:Label text="Online" name="Title" class="window-title" />
            <ui:VisualElement name="Close" class="window-close-button" />
        </ui:VisualElement>
        <ui:VisualElement name="Container" class="window-container">
            <ui:VisualElement name="ScrollView" class="scrollview" style="width: auto; height: auto;">
                <ui:VisualElement name="Viewport" class="scrollview-viewport" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; background-color: rgba(255, 255, 255, 0);">
                    <ui:VisualElement name="Container" class="scrollview-container" style="width: 100%; height: auto; background-color: rgba(0, 0, 0, 0); padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px;">
                        <ui:Instance template="OnlineTemplate" name="OnlineTemplate" />
                        <ui:Instance template="OnlineTemplate" name="OnlineTemplate" />
                        <ui:Instance template="OnlineTemplate" name="OnlineTemplate" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="ScrollerHorizontal" class="scroller-horizontal scrollview-horizontal-scroller" style="right: 0; display: none;">
                    <ui:VisualElement name="Dragger" class="scroller-horizontal-dragger scrollview-horizontal-scroller-dragger" />
                </ui:VisualElement>
                <ui:VisualElement name="ScrollerVertical" class="scroller-vertical scrollview-vertical-scroller" style="display: none;">
                    <ui:VisualElement name="Dragger" class="scroller-vertical-dragger scrollview-vertical-scroller-dragger" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
